<div class="ftr-rewards-launcher" data-ftr-rewards-launcher data-account-url="{{ routes.account_url }}">
  <button class="ftr-rewards-launcher__button" type="button" aria-expanded="false" aria-controls="ftr-rewards-panel">★ {{ block.settings.label | escape }}</button>
  <aside id="ftr-rewards-panel" class="ftr-rewards-launcher__panel" hidden>
    <button class="ftr-rewards-launcher__close" type="button" aria-label="Close rewards">×</button>
    <p class="ftr-rewards-launcher__eyebrow">FreeTheRoots Rewards</p>
    <h3>Rewards grow with every order.</h3>
    <p>Sign in to see your points, available rewards, and recent activity.</p>
    <a href="{{ routes.account_url }}">View my rewards</a>
  </aside>
</div>

{% schema %}
{
  "name": "Rewards launcher",
  "target": "body",
  "javascript": "rewards-launcher.js",
  "stylesheet": "rewards.css",
  "settings": [
    {"type":"text","id":"label","label":"Launcher label","default":"Rewards"}
  ]
}
{% endschema %}
