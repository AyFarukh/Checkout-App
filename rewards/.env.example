# Shopify CLI supplies SHOPIFY_API_KEY, SHOPIFY_API_SECRET and PORT during `shopify app dev`.
# Set MongoDB locally or in your hosting environment.
MONGODB_URI=mongodb://127.0.0.1:27017/freetheroot_rewards
MONGODB_DB_NAME=freetheroot_rewards

# Optional local-only fallback for API testing outside Shopify Admin.
REWARDS_ADMIN_KEY=change-me
