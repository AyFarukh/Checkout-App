# Shopify CLI supplies SHOPIFY_API_KEY, SHOPIFY_API_SECRET and PORT during `shopify app dev`.
MONGODB_URI=mongodb://127.0.0.1:27017/freetheroot_rewards?replicaSet=rs0
MONGODB_DB_NAME=freetheroot_rewards

# Background Admin GraphQL. Production should persist each shop's encrypted offline
# token in a secrets/session store. JSON is supported for controlled single-service deployments.
SHOPIFY_ADMIN_API_VERSION=2026-07
SHOPIFY_OFFLINE_TOKENS_JSON={"example.myshopify.com":"replace-with-offline-token"}
# Single-shop fallback only:
# SHOPIFY_ADMIN_ACCESS_TOKEN=

SHOPIFY_REWARDS_FUNCTION_ID=
REWARDS_WEBHOOK_MAX_ATTEMPTS=8
REWARDS_WEBHOOK_LOCK_MS=300000
