# Local process only. Never apply these values to the existing production Fly app.
NODE_ENV=test
MONGODB_URI=mongodb://127.0.0.1:27027/freetheroot_loop_test
MONGODB_DB_NAME=freetheroot_loop_test
# Use your actual authorized Shopify shop, customer ID and application secret.
LOOP_TEST_SHOP=your-store.myshopify.com
LOOP_TEST_CUSTOMER_ID=
SHOPIFY_API_SECRET=
LOOP_TEST_SUBSCRIPTION_ID=42347174
LOOP_BILLING_TIMEZONE=America/New_York
LOOP_ADMIN_API_URL=https://api.loopsubscriptions.com/admin/2026-04
LOOP_ADMIN_REQUEST_HEADERS_JSON={"X-Loop-Token":""}
LOOP_TEST_MUTATIONS_ENABLED=false
LOOP_SUBSCRIPTION_MUTATIONS_ENABLED=false
# Set only after inspecting the subscription and reviewing each test payload.
LOOP_LIVE_TEST_ACK=
LOOP_LIVE_FIXTURES=test/fixtures/loop-live-actions.json
LOOP_LIVE_STATE_FILE=.loop-live-state.json
